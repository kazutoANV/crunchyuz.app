rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        (request.auth.token.email == 'kazutokvf@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    match /anime/{id} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{e} {
      allow get: if request.auth != null && request.auth.token.email == e;
      allow write: if request.auth != null && request.auth.token.email == 'kazutokvf@gmail.com';
    }
  }
}
